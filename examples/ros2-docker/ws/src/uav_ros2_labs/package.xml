<?xml version="1.0"?>
<package format="3">
  <name>uav_ros2_labs</name>
  <version>0.1.0</version>
  <description>ROS 2 labs for the UAV Student course: telemetry logger, PX4 offboard square, ArduPilot AP_DDS square.</description>
  <maintainer email="noreply@example.com">UAV Student</maintainer>
  <license>MIT</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>px4_msgs</exec_depend>
  <exec_depend>ardupilot_msgs</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
