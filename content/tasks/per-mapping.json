     17.3,
     23.5,
     35.9
    ],
    "f": [
     4.5,
     8.8,
     12,
     15,
     24,
     35
    ],
    "w": [
     4000,
     5472,
     6000,
     8192
    ],
    "h": {
     "min": 30,
     "max": 150,
     "step": 5
    }
   },
   "answer": "h*sw/(f*w)*100",
   "unit": "см/px",
   "tol": 0.01,
   "solution": "GSD = H·w_сенсора/(f·W_px), ×100 для см."
  },
  {
   "id": "spacing",
   "title": "Шаг съёмки",
   "statement": "Высота **{h} м**, вертикальный угол обзора (вдоль галса) **{v}°**, продольное перекрытие **{p} %**. Найдите шаг между снимками (м).",
   "params": {
    "h": {
     "min": 40,
     "max": 150,
     "step": 10
    },
    "v": {
     "min": 40,
     "max": 70,
     "step": 2
    },
    "p": [
     70,
     75,
     80,
     85
    ]
   },
   "answer": "2*h*math.tan(math.radians(v)/2)*(1-p/100)",
   "unit": "м",
   "tol": 0.01,
   "solution": "footprint = 2H·tan(VFOV/2); шаг = footprint·(1 − p)."
  }
 ]
